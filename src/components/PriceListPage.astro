---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import DepositNote from './DepositNote.astro';
import PageHero from './PageHero.astro';
import PriceLedger from './PriceLedger.astro';
import ClosingCta from './ClosingCta.astro';
import Base from '../layouts/Base.astro';
import mrPhoto from '../assets/photos/mr-signa-elokeszites.jpg';
import { localeOf } from '../lib/locale';
import { linker } from '../lib/translations';
import { ui } from '../lib/ui';

interface Props {
  /** Title, description, heading, lead and the notes (Markdown body) of the page. */
  page: CollectionEntry<'pages'>;
  breadcrumb: string;
  sections: { id: string; title: string; rows: CollectionEntry<'prices'>[]; notes?: (string | undefined)[] }[];
  /** Exam page per price row id. */
  links?: Record<string, string>;
  /** Offer a search box; worth it for long lists. */
  searchable?: boolean;
  deposit?: boolean;
}
const { page, breadcrumb, sections, links = {}, searchable = false, deposit = false } = Astro.props;
const { Content } = await render(page);
const locale = localeOf(Astro.url);
const t = ui[locale].priceList;
const link = await linker(locale);
---

<Base title={page.data.title} description={page.data.description}>
  <PageHero
    short
    breadcrumbs={[{ label: t.pricesCrumb, href: link('/arak') }, { label: breadcrumb }]}
    title={page.data.heading}
    image={{ src: mrPhoto, alt: t.heroAlt }}
  >
    {page.data.lead && <p class="mt-4 max-w-[36rem] text-lg text-mist">{page.data.lead}</p>}
  </PageHero>

  <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-10 pb-16 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-x-16 lg:pb-20">
    <div class="grid min-w-0 content-start gap-12">
      {
        searchable && (
          <div data-price-filter data-ui={JSON.stringify(t.script)} hidden class="grid gap-2">
            <label for="arlista-kereses" class="font-bold">
              {t.search}
            </label>
            <input
              id="arlista-kereses"
              type="search"
              autocomplete="off"
              placeholder={t.searchPlaceholder}
              class="h-12 w-full max-w-md rounded-md border border-ink/30 bg-paper px-4 text-lg placeholder:text-ink-muted"
            />
            <p data-count aria-live="polite" class="min-h-6 text-sm text-ink-muted" />
          </div>
        )
      }

      {
        sections.map(({ id, title, rows, notes = [] }) => (
          <section aria-labelledby={id} data-price-section>
            <h2 id={id} class="text-2xl font-semibold">
              {title}
            </h2>
            {notes.some(Boolean) && (
              <div class="mt-3 grid gap-2 text-sm text-ink-muted">
                {notes.filter(Boolean).map((note) => (
                  <p class="max-w-[36rem]">{note}</p>
                ))}
              </div>
            )}
            <div class="mt-5">
              <PriceLedger rows={rows} links={links} />
            </div>
          </section>
        ))
      }
    </div>

    <aside class="grid content-start gap-8">
      <div class="copy text-[0.95rem]"><Content /></div>
      {deposit && <DepositNote level="h2" />}
    </aside>
  </div>
  <ClosingCta />
</Base>

<script>
  // Find an exam in a long list: matches ignore case and accents ("terd" finds "Térd").
  // The search box stays hidden without JavaScript, and the full list stays readable.
  const filter = document.querySelector<HTMLElement>('[data-price-filter]');
  const input = filter?.querySelector('input');
  const count = filter?.querySelector('[data-count]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-price-section]')];
  const rows = sections.flatMap((s) => [...s.querySelectorAll('li')]);
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const texts = rows.map((r) => fold(r.textContent ?? ''));
  // The page's language: the words are set on the element by the template.
  const words: { results: string; result: string; none: string } = JSON.parse(filter?.dataset.ui ?? '{}');

  if (filter && input && count) {
    filter.hidden = false;
    input.addEventListener('input', () => {
      const query = fold(input.value.trim());
      let shown = 0;
      rows.forEach((row, i) => {
        const hit = !query || texts[i]!.includes(query);
        row.hidden = !hit;
        if (hit) shown++;
      });
      for (const section of sections) section.hidden = Boolean(query) && !section.querySelector('li:not([hidden])');
      count.textContent = !query ? '' : shown ? `${shown}${shown === 1 ? words.result : words.results}` : words.none;
    });
  }
</script>
