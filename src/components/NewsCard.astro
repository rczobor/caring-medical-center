---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { describe } from '../lib/describe';
import { formatDate } from '../lib/format';
import { localeOf } from '../lib/locale';

interface Props {
  article: CollectionEntry<'site'> & { date: Date };
  /** The newest article: across the whole row, picture beside the text from desktop width. */
  lead?: boolean;
}
const { article, lead = false } = Astro.props;
const { id, date, data, body } = article;
const locale = localeOf(Astro.url);
---

<li
  class:list={[
    'relative flex flex-col',
    lead && 'sm:col-span-2 lg:col-span-3 lg:grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-x-10',
  ]}
>
  {
    data.image && (
      <Image
        src={data.image}
        alt=""
        widths={lead ? [640, 960, 1280] : [400, 640, 800]}
        sizes={lead ? '(min-width: 1152px) 640px, 100vw' : '(min-width: 1152px) 352px, (min-width: 640px) 50vw, 100vw'}
        loading={lead ? 'eager' : 'lazy'}
        class={`mb-4 aspect-[3/2] w-full rounded-md bg-line object-cover${lead ? ' lg:mb-0' : ''}`}
      />
    )
  }
  <div class="flex flex-col">
    <time datetime={date.toISOString().slice(0, 10)} class="mb-2 text-sm text-ink-muted">
      {formatDate(date, locale)}
    </time>
    <h3 class:list={['leading-snug text-balance', lead ? 'font-display text-2xl font-semibold tracking-[-0.015em] sm:text-3xl' : 'text-xl font-bold']}>
      <!-- The title link covers the card, so the picture leads to the article too. -->
      <a href={`/${id}`} class="link-bar after:absolute after:inset-0 after:rounded-md">
        {data.heading}
      </a>
    </h3>
    <p class:list={['mt-2 text-ink-muted', lead && 'sm:text-lg']}>{describe(body ?? '', '', lead ? 240 : 140)}</p>
  </div>
</li>
