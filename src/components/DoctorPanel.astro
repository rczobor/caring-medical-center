---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { localeOf, localize } from '../lib/locale';
import { ui } from '../lib/ui';

interface Props {
  doctors: CollectionEntry<'doctors'>[];
  /** Under the doctors, e.g. that a partner provides the service. */
  note?: string | undefined;
  /**
   * The doctors can be booked online here, so this is the page's booking panel
   * (#foglalas): the header button and the phone booking bar lead to it.
   */
  booking?: boolean;
}
const { doctors, note, booking = false } = Astro.props;
const locale = localeOf(Astro.url);
const t = ui[locale];
---

<!-- Beside the copy and sticky on desktop (the page's aside), after the copy on phones. -->
<section id={booking ? 'foglalas' : undefined} aria-labelledby="orvosaink" class="scroll-mt-4 rounded-md border border-ink/20 bg-paper">
  <h2 id="orvosaink" class="border-b border-line px-5 pt-5 pb-4 text-xl font-semibold">{t.doctorsTitle}</h2>
  <ul class="divide-y divide-line">
    {
      doctors.map((doctor) => localize(doctor, locale)).map(({ data }) => (
        <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-4 px-5 py-4">
          {/* The name says who it is, so the portrait is decorative. */}
          {data.photo ? (
            <Image
              src={data.photo}
              alt=""
              widths={[72, 144]}
              sizes="72px"
              class="row-span-3 aspect-square w-full rounded-md bg-line object-cover object-top"
            />
          ) : (
            <span class="row-span-3" />
          )}
          <h3 class="self-end leading-snug font-bold">
            {data.profile ? (
              <a href={data.profile} class="underline decoration-ink/30 underline-offset-4 hover:decoration-ink">
                {data.name}
              </a>
            ) : (
              data.name
            )}
          </h3>
          <p class="text-sm leading-snug text-ink-muted">{data.role}</p>
          {data.booking && (
            <a
              href={data.booking}
              aria-label={t.bookOnlineAt(data.name)}
              class="mt-3 inline-flex h-11 items-center justify-self-start rounded-full bg-gold px-5 text-sm font-bold text-ink hover:brightness-95"
            >
              {t.bookOnline}
            </a>
          )}
        </li>
      ))
    }
  </ul>
  {note && <p class="border-t border-line px-5 py-4 text-sm leading-snug text-ink-muted">{note}</p>}
</section>
