---
interface Props {
  steps: {
    title: string;
    text: string;
    /** Pages to go to at this step; `price` is shown beside the name, e.g. "57 900 Ft-tól". */
    links?: { name: string; page: string; price?: string | undefined }[];
  }[];
}
const { steps } = Astro.props;
---

<!-- One path: numbered stops joined by a gold line, the numerals in the left gutter. -->
<ol class="mt-5 grid">
  {
    steps.map(({ title, text, links }, i) => (
      <li class="reveal relative grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-4 pb-8 last:pb-0">
        {i < steps.length - 1 && <span aria-hidden="true" class="draw-down absolute top-12 bottom-1 left-[1.375rem] w-0.5 -translate-x-1/2 rounded-full bg-gold" />}
        <span
          aria-hidden="true"
          class="flex size-11 items-center justify-center rounded-full border-2 border-gold bg-paper text-lg font-bold text-gold-ink tabular-nums"
        >
          {i + 1}
        </span>
        <div class="pt-2.5">
          <h3 class="font-bold">{title}</h3>
          <p class="copy mt-1.5 text-ink-muted">{text}</p>
          {links && links.length > 0 && (
            <ul class="mt-3 max-w-[36rem] border-t border-line">
              {links.map(({ name, page, price }) => (
                <li class="border-b border-line">
                  <a href={page} class="group flex min-h-12 items-center justify-between gap-4 py-2.5 font-medium">
                    <span class="link-bar">{name}</span>
                    <span class="flex shrink-0 items-center gap-3">
                      {price && <span class="text-sm font-bold whitespace-nowrap tabular-nums">{price}</span>}
                      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="shrink-0 text-gold-ink transition-transform group-hover:translate-x-1 motion-reduce:transition-none">
                        <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
