---
/**
 * The home hero's Christmas season: falling snow, a string of lights hung under the header and a
 * snowbank leading into the page. Place it first in the hero, a positioned dark band; the
 * hero's copy needs `relative z-[2]` to stay above the snow. HolidayTree goes in the photo.
 */
import { season } from '../lib/season-colors';

// Red, gold, green and blue (shared with the tree), repeating along the string.
const colors = [season.red, season.gold, season.green, season.blue];
// Each loop is a quadratic curve from (-4, 1) through the control point (width / 2, 1 + pull)
// to (width + 4, 1); it sags half the pull.
const loop = { width: 160, pull: 22 };
// Enough loops for a 2560 px window; the row is centred and clipped.
const loops = 16;
const along = [0.15, 0.38, 0.62, 0.85];
const wire = `M-4 1 Q${loop.width / 2} ${1 + loop.pull} ${loop.width + 4} 1`;
const bulb = (u: number) => {
  const k = 1 - u;
  const x = k * k * -4 + 2 * k * u * (loop.width / 2) + u * u * (loop.width + 4);
  const y = k * k + 2 * k * u * (1 + loop.pull) + u * u;
  // Centred on the wire, the socket just under it.
  return { left: `${(x - 4).toFixed(1)}px`, top: `${(y + 1).toFixed(1)}px` };
};
const rows = Array.from({ length: loops }, (_, l) =>
  along.map((u, b) => {
    const i = l * along.length + b;
    // Uneven timing so the string flickers like real bulbs, not in step.
    return { ...bulb(u), color: colors[i % colors.length], delay: `${((i * 0.37) % 2.6).toFixed(2)}s`, duration: `${(1.9 + ((i * 0.73) % 1.7)).toFixed(2)}s` };
  }),
);
---

<!--
  The season, by the visitor's own date: 1 December to 6 January (Epiphany). It runs before
  the hero paints, so nothing pops in. `?season=christmas` or `?season=off` overrides it, for
  previews before December and for tests.
-->
<script is:inline>
  {
    const override = new URLSearchParams(location.search).get('season');
    const today = new Date();
    const inSeason = today.getMonth() === 11 || (today.getMonth() === 0 && today.getDate() <= 6);
    if (override ? override === 'christmas' : inSeason) document.documentElement.dataset.season = 'christmas';
  }
</script>
<!-- From desktop width the lights cross the bright photo; a soft shade under them keeps their glow. -->
<div data-holiday aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-[1] hidden h-9 w-[44%] bg-gradient-to-b from-night/45 to-transparent lg:block"></div>
<canvas data-holiday data-snow aria-hidden="true" class="pointer-events-none absolute inset-0 z-[1] size-full"></canvas>
<div data-holiday aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 z-[5] flex h-10 justify-center overflow-hidden">
  {
    rows.map((bulbs) => (
      <div class="relative h-10 flex-none" style={{ width: `${loop.width}px` }}>
        <svg viewBox={`0 0 ${loop.width} 40`} width={loop.width} height="40" class="absolute inset-0 overflow-visible">
          <path d={wire} fill="none" stroke="#2b3a33" stroke-width="1.5" />
        </svg>
        {bulbs.map((b) => (
          <span class="bulb" style={{ left: b.left, top: b.top, background: b.color, '--glow': `color-mix(in oklch, ${b.color} 55%, transparent)`, animationDelay: b.delay, animationDuration: b.duration }} />
        ))}
      </div>
    ))
  }
</div>
<!--
  The snowbank runs into the white band below the hero: low under the copy, heaped into a drift
  at 56%, where the photo's gold edge meets it and HolidayTree stands. A crest layer under the
  white gives it body, not a wavy divider's single edge.
-->
<svg data-holiday aria-hidden="true" viewBox="0 0 1280 80" preserveAspectRatio="none" class="pointer-events-none absolute inset-x-0 -bottom-px z-[3] h-8 w-full lg:h-20">
  <path d="M0 61 C 200 55, 420 57, 560 49 C 640 41, 690 25, 740 23 C 800 21, 860 35, 940 45 C 1060 55, 1180 53, 1280 49 L 1280 80 L 0 80 Z" fill="var(--color-line)" />
  <path d="M0 65 C 200 59, 420 61, 560 54 C 640 46, 690 30, 740 28.5 C 800 27, 860 40, 940 50 C 1060 59, 1180 57, 1280 54 L 1280 80 L 0 80 Z" fill="var(--color-paper)" />
</svg>

<script>
  // The snow loads only in season, so the rest of the year costs one small check.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-snow]');
  if (canvas && document.documentElement.dataset.season === 'christmas') {
    void import('../lib/snow').then(({ startSnow }) => startSnow(canvas));
  }
</script>

<style>
  .bulb {
    position: absolute;
    width: 8px;
    height: 12px;
    border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
    box-shadow: 0 0 9px 2px var(--glow);
    animation: twinkle 2.6s ease-in-out infinite;
  }
  /* The bulb's socket. */
  .bulb::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 1px;
    width: 6px;
    height: 4px;
    border-radius: 1px;
    background: #2b3a33;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    40% {
      opacity: 0.9;
    }
    55% {
      opacity: 0.4;
    }
    70% {
      opacity: 0.95;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bulb {
      animation: none;
    }
  }
</style>
