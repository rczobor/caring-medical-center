---
import { lineColours } from '../lib/transit';

interface Props {
  /** A Budapest metro line, "M1" to "M4". */
  line: string;
}
const { line } = Astro.props;
// The line's own colour from OpenStreetMap (scripts/clinic-map.ts), with whichever of ink and
// white contrasts more with it (WCAG relative luminance): ink on M1's yellow and M4's green,
// white on M2's red and M3's blue.
const colour = lineColours[line as keyof typeof lineColours] ?? '#55524a';
const luminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
};
const ink = '#1c1b17';
const background = luminance(colour);
const text = (background + 0.05) / (luminance(ink) + 0.05) > 1.05 / (background + 0.05) ? ink : '#ffffff';
---

<span
  class="grid size-5 shrink-0 place-items-center rounded-full text-[0.625rem] font-bold shadow-[0_0_0_2px_var(--color-paper)]"
  style={`background: ${colour}; color: ${text}`}>{line}</span
>
