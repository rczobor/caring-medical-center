---
import type { ImageMetadata } from 'astro';
import { photoTransition } from '../lib/view-transition';
import Breadcrumbs from './Breadcrumbs.astro';
import Photo from './Photo.astro';

interface Props {
  /** Omitted on top-level pages, where the only crumb would repeat the title. */
  breadcrumbs?: { label: string; href?: string }[] | undefined;
  /** A short label above the title. */
  eyebrow?: string | undefined;
  title: string;
  /** Decision facts (price, time, …) in a grid under the title. */
  facts?: { label: string; value: string }[] | undefined;
  image?: { src: ImageMetadata; alt: string } | undefined;
  /** An index or tool page (prices, news, contact): a shorter photo strip on phones, so its list starts on the first screen. */
  short?: boolean;
}
const { breadcrumbs, eyebrow, title, facts, image, short = false } = Astro.props;
// A dash between words stays with the word before it, so no line of a large title starts with one.
const heading = title.replace(/ ([-–]) /g, '\u00a0$1 ');
---

<!--
  The reading room, as on the home page: a dark green-ink band where the photo is the light.
  The photo is a lit panel, edge to edge at the top on phones and running to the window's right
  edge on desktop, with a gold line where it meets the band. Slot content sits on night: use
  cream, mist and gold, not the ink tones.
-->
<div class="relative isolate overflow-hidden bg-night text-cream">
  {
    image && (
      <div class:list={['relative sm:h-72 lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[44%]', short ? 'h-44' : 'h-52']}>
        <Photo
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 44vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class:list={['size-full bg-night-raised object-cover', short ? 'object-[50%_20%] lg:object-[50%_35%]' : 'object-[50%_35%]']}
          style={photoTransition(image.src)}
          {/* The strip at its narrowest: a 320 px phone over the strip's 11rem or 13rem. */}
          crop={{ below: 1024, aspect: short ? 320 / 176 : 320 / 208, position: short ? '50% 20%' : '50% 35%', sizes: '100vw' }}
        />
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-[3px] bg-gold lg:inset-x-auto lg:inset-y-0 lg:left-0 lg:h-auto lg:w-[3px]" />
      </div>
    )
  }
  <div class:list={['mx-auto max-w-6xl px-4 pt-6 pb-10', image ? 'lg:flex lg:min-h-[22rem] lg:items-center lg:py-14' : 'lg:pt-8 lg:pb-14']}>
    <div class:list={[image ? 'lg:w-[52%] lg:pr-6' : 'max-w-3xl']}>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {/* Search excerpts start at the title: the eyebrow repeats it, and the facts' cells run together. */}
      {eyebrow && <p data-pagefind-ignore class:list={['font-display font-semibold text-gold', breadcrumbs && 'mt-5']}>{eyebrow}</p>}
      <h1
        class:list={[
          eyebrow ? 'mt-2' : breadcrumbs && 'mt-5',
          'font-display text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-pretty',
        ]}
      >
        {heading}
      </h1>
      <slot />
      {
        facts && (
          <dl data-pagefind-ignore class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-cream/15 pt-5 sm:grid-cols-4 lg:grid-cols-2">
            {facts.map(({ label, value }) => (
              <div>
                <dt class="text-sm text-mist">{label}</dt>
                <dd class="mt-1 font-display text-xl leading-snug font-semibold whitespace-nowrap text-gold tabular-nums sm:text-2xl">{value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</div>
