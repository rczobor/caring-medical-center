---
import { uiFor } from '../lib/ui';

interface Props {
  /** Ancestors first; the current page comes last and is not linked. */
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
const t = uiFor(Astro.url);
---

<nav aria-label={t.breadcrumbs} data-pagefind-ignore class="text-sm text-mist">
  <ol class="flex flex-wrap gap-x-2 gap-y-1">
    {
      items.map(({ label, href }, i) => (
        <li class="flex gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {href ? (
            <a href={href} class="underline-offset-4 hover:text-cream hover:underline">
              {label}
            </a>
          ) : (
            <span aria-current="page" class="text-cream">
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
