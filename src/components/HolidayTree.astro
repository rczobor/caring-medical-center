---
import { season } from '../lib/season-colors';

/**
 * A small decorated tree for the home hero's Christmas season, shown only in season (see
 * HolidayDecor). On phones it stands on its own snow drift on the gold line, over the desk at the
 * photo's lower left, clear of the people. From desktop width it stands in the snowbank's drift
 * where the photo's gold edge meets it, a little off centre so the line passes behind a branch
 * instead of running into the star. Place it in the photo box. No glow: the string lights carry the
 * scene's light, and a halo would blur the tree's outline against the dark band.
 *
 * Drawn to look made, not stamped: three overlapping tiers with scalloped, uneven hems, each
 * shaded across four greens from the dark side to the lit one; snow caught on some tips; a few
 * baubles of mixed sizes, gold leading, placed off any grid.
 */
const baubles = [
  { x: 32.6, y: 19.6, r: 1.4, fill: season.red },
  { x: 25.4, y: 31.6, r: 2, fill: season.gold },
  { x: 36.8, y: 34.4, r: 1.6, fill: season.blue },
  { x: 29, y: 48.2, r: 2.4, fill: season.gold },
  { x: 42.4, y: 53.6, r: 1.8, fill: season.red },
  { x: 18.4, y: 55.2, r: 2.1, fill: season.gold },
].map((b, i) => ({ ...b, delay: `${((i * 0.83) % 2.4).toFixed(2)}s` }));
// Back to front: each tier's hem droops in scallops, its tips a little uneven left to right.
const tiers = [
  'M30 27 L54 61 Q50 59.4 46.6 61.8 Q42.6 59.8 38.6 62.4 Q34.4 60 30.2 62.6 Q26 60.2 21.8 62.2 Q17.8 59.8 14 61.6 Q10.4 59.6 6.6 60.8 Z',
  'M30 15 L44.8 39.6 Q41.6 38.4 39.2 40.6 Q36.4 38.8 33.4 41.2 Q30.4 39 27.4 41 Q24.4 38.8 21.6 40.6 Q19 38.6 15.8 39.8 Z',
  'M30 6.5 L38.4 23 Q35.6 22 33.6 24 Q31.6 22.6 29.4 24.4 Q27 22.6 24.8 23.8 Q23.2 22.4 21.8 23.2 Z',
];
// Snow lying on some tier tips, following their slope.
const caps = ['M35.6 22.4 Q37 21 38.6 22.9 Q37 22.3 35.9 23.1 Z', 'M41.4 38.6 Q43.4 37 45 39.5 Q43.2 38.8 41.8 39.3 Z', 'M15.6 39.7 Q17.4 37.6 19.6 38.8 Q17.6 38.7 16.2 40 Z', 'M49.6 59.6 Q52.2 57.8 54.2 60.9 Q52 60 50.2 60.4 Z', 'M6.4 60.7 Q8.6 58.4 11.6 59.6 Q9.2 59.6 7 61 Z'];
---

<div data-holiday aria-hidden="true" class="tree pointer-events-none absolute bottom-px left-4 z-[4] h-[91px] w-[76px] lg:bottom-[38px] lg:left-0 lg:h-[144px] lg:w-[120px] lg:-translate-x-1/3 xl:h-[163px] xl:w-[136px]">
  <svg viewBox="0 0 60 72" class="block size-full overflow-visible">
    <defs>
      <linearGradient id="season-tree-shade" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#133625" />
        <stop offset="0.45" stop-color="#1c4f35" />
        <stop offset="0.75" stop-color="#256745" />
        <stop offset="1" stop-color="#2e7a52" />
      </linearGradient>
    </defs>
    <!-- Phones: a small drift in the snowbank's white and crest, on the gold line. Desktop: the bank. -->
    <g class="lg:hidden">
      <path d="M7 72 Q30 63.6 53 72 Z" fill="var(--color-paper)" />
      <path d="M7 72 Q30 63.6 53 72" fill="none" stroke="var(--color-line)" stroke-width="0.9" />
    </g>
    <rect x="27.8" y="61" width="4.4" height="7" rx="0.8" fill="#4f3522" />
    {tiers.map((d) => <path d={d} fill="url(#season-tree-shade)" />)}
    {caps.map((d) => <path d={d} fill="#f4f6f8" />)}
    {
      baubles.map((b) => (
        <g class="ornament" style={{ animationDelay: b.delay }}>
          <circle cx={b.x} cy={b.y} r={b.r} fill={b.fill} />
          <circle cx={b.x - b.r * 0.35} cy={b.y - b.r * 0.35} r={b.r * 0.3} fill="#fff" opacity="0.75" />
        </g>
      ))
    }
    <polygon class="star" points="30,1.5 30.85,4.03 33.52,4.06 31.38,5.65 32.17,8.19 30,6.65 27.83,8.19 28.62,5.65 26.48,4.06 29.15,4.03" fill={season.gold} />
  </svg>
</div>

<style>
  .ornament {
    animation: twinkle 2.4s ease-in-out infinite;
  }
  .star {
    animation: pulse 3s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    55% {
      opacity: 0.55;
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.75;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ornament,
    .star {
      animation: none;
    }
  }
</style>
